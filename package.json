{
  "name": "entur-cli",
  "version": "0.2.0",
  "description": "A command-line interface for the Entur APIs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jvm/entur-cli.git"
  },
  "homepage": "https://github.com/jvm/entur-cli#readme",
  "bugs": {
    "url": "https://github.com/jvm/entur-cli/issues"
  },
  "author": "Jose Mocito",
  "keywords": [
    "entur",
    "cli",
    "norway",
    "public-transport",
    "transit",
    "journey-planner",
    "geocoder",
    "mobility"
  ],
  "type": "module",
  "bin": {
    "entur": "bin/entur.js"
  },
  "files": [
    "bin",
    "src",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "smoke": "ENTUR_SMOKE=1 node --test test/*.test.js",
    "audit": "npm audit --omit=dev --audit-level=high",
    "verify-pack": "npm pack --dry-run",
    "validate": "npm test && npm run audit",
    "security:secrets": "bash scripts/dev-security.sh secrets",
    "security:scripts": "bash scripts/dev-security.sh scripts",
    "security:workflows": "bash scripts/dev-security.sh workflows",
    "security:local": "npm run audit && npm run security:secrets && npm run security:scripts && npm run security:workflows",
    "postinstall": "lefthook install || true"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "lefthook": "^2.1.10"
  },
  "allowScripts": {
    "lefthook@2.1.10": true
  }
}
